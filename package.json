{
  "name": "talentmap-ai",
  "version": "1.0.0",
  "private": true,
  "description": "TalentMap AI — навигатор развития талантов детей. Express + SQLite backend.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "setup": "npm install && npm --prefix client install",
    "seed": "node src/db/reseed.js",
    "test": "node --test tests/*.test.js",
    "lint": "npm --prefix client run lint",
    "venues": "node scripts/build-venues.js",
    "test:links": "node tests/links.mjs",
    "demo:data": "node scripts/build-demo-data.js",
    "demo:build": "npm run demo:data && npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "sqlite3": "^5.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "supertest": "^7.2.2"
  }
}
