# ─────────────────────────────────────────────────────────────────────────────
#  TalentMap AI — переменные окружения
#  Скопируйте в .env и заполните:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Окружение и порт
NODE_ENV=development
PORT=3000

# ─── Обязательно для продакшена ──────────────────────────────────────────────
# Секрет для подписи JWT. Минимум 32 символа.
# Сервер откажется стартовать в продакшене без него — это защита от
# предсказуемого секрета, с которым любой может подделать чужую сессию.
# Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── База данных ─────────────────────────────────────────────────────────────
# Путь к файлу SQLite. По умолчанию ./data/talentmap.db
# DB_PATH=/var/lib/talentmap/talentmap.db

# ─── Загрузка файлов ─────────────────────────────────────────────────────────
# UPLOAD_DIR=./uploads
# UPLOAD_MAX_BYTES=5242880

# ─── CORS ────────────────────────────────────────────────────────────────────
# Список разрешённых origin через запятую. Пусто = в разработке разрешён
# localhost. В продакшене укажите домен явно.
# CORS_ORIGINS=https://talentmap.example.ru

# ─── ИИ (необязательно) ──────────────────────────────────────────────────────
# Без ключа приложение полностью работоспособно: диагностика считается
# детерминированным движком, а тьютор и критик работ отвечают в офлайн-режиме.
# С ключом подключается любой OpenAI-совместимый провайдер.
#
# Groq (быстро и бесплатно): https://console.groq.com/keys
# AI_API_KEY=
# AI_API_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
#
# OpenAI:
# AI_API_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# AI_TIMEOUT_MS=20000

# ─── Яндекс SmartCaptcha (необязательно) ─────────────────────────────────────
# Капча проверяется только если задан секрет. Пусто = проверка отключена.
# YANDEX_CAPTCHA_SECRET_KEY=

# ─── Учётная запись администратора ───────────────────────────────────────────
# Создаётся при первом запуске. ОБЯЗАТЕЛЬНО смените пароль для продакшена.
ADMIN_EMAIL=admin@talentmap.ai
ADMIN_PASSWORD=admin12345
